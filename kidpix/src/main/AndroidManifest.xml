<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar.Fullscreen"
        android:hardwareAccelerated="true">
        <activity
            android:name=".app.PaintActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|density|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The WebView app's activity name: kiosk scripts and shortcuts start dev.kidpix.tablet/.MainActivity. -->
        <activity-alias
            android:name="dev.kidpix.tablet.MainActivity"
            android:targetActivity=".app.PaintActivity"
            android:exported="true" />
        <!-- Action log debug hooks (adb shell am broadcast; only the shell holds DUMP). -->
        <receiver
            android:name=".app.LogDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.kidpix.LOG_EXPORT" />
                <action android:name="dev.kidpix.LOG_VERIFY" />
                <action android:name="dev.kidpix.LOG_STATS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
